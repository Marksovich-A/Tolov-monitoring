# Firebase konsolidan olingan qiymatlar (Project settings > Your apps > Web app).
# Bu faylni .env.local nomi bilan nusxalab, qiymatlarni to'ldiring.
# Bo'sh qoldirsangiz, panel demo rejimda ishlaydi.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Ixtiyoriy: kirish oynasida ko'rsatiladigan test hisob (Firebase rejimida).
# Avval shu telefon va parol bilan bir marta ro'yxatdan o'tib qo'yishingiz kerak.
# Diqqat: bu qiymatlar saytda hammaga ko'rinadi, shuning uchun haqiqiy parol qo'ymang.
VITE_TEST_PHONE=
VITE_TEST_PASSWORD=
